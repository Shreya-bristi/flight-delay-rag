{
  "title": "Flight Delay RAG - overview",
  "uid": "fdr-overview",
  "tags": [
    "fdr"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Cluster-only overview: questions, LLM calls, AirLabs and pod health. Pod panels read kube-state-metrics, the kubelet and node-exporter, which exist only on EKS, so this file is NOT in deploy/grafana/dashboards/ (loaded by docker compose, where they would be permanently blank). Display only: nothing here changes the chatbot. Loaded by make eks-monitoring.",
  "panels": [
    {
      "type": "stat",
      "title": "Questions per minute",
      "description": "Questions the chatbot handled per minute (every /ask turn, including clarifying questions and declines).",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "textMode": "value",
        "colorMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "sum(rate(rag_requests_total[5m]))*60",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No questions yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1
        }
      }
    },
    {
      "type": "stat",
      "title": "LLM call errors",
      "description": "Share of calls to the LLM (Groq) that returned no usable answer in the last 5 minutes. On the Groq free tier this is usually a rate limit (429).",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "textMode": "value",
        "colorMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "sum(rate(llm_calls_total{outcome=~\"request_error|transient_error|malformed|empty\"}[5m])) / clamp_min(sum(rate(llm_calls_total[5m])),0.0001)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No LLM calls yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          },
          "unit": "percentunit"
        }
      }
    },
    {
      "type": "stat",
      "title": "LLM answer time (p95)",
      "description": "How long the LLM took to produce an answer (95th percentile, last 15 minutes), including a retry when the first answer failed its citation check.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "textMode": "value",
        "colorMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_stage_duration_seconds_bucket{stage=\"generate\"}[15m])) by (le))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No LLM calls yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "unit": "s",
          "decimals": 1
        }
      }
    },
    {
      "type": "stat",
      "title": "API pods ready (of 2)",
      "description": "Chatbot API pods that are Ready. 2 = normal, 1 = still serving with no spare, 0 = the chatbot is down.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "textMode": "value",
        "colorMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "sum(kube_deployment_status_replicas_available{namespace=\"fdr\",deployment=\"api\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Pod restarts (last hour)",
      "description": "Container restarts in the chatbot (fdr) and monitoring namespaces over the last hour. 0 is normal.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "textMode": "value",
        "colorMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"fdr|monitoring\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "decimals": 0
        }
      }
    },
    {
      "type": "stat",
      "title": "AirLabs lookups left (this deployment)",
      "description": "AirLabs flight lookups left this month AS COUNTED BY THIS DEPLOYMENT: the monthly quota (1000) minus the live calls recorded in this deployment's own database. It cannot see calls made with the same key elsewhere (local runs, earlier deployments), so the real balance on the AirLabs account can be lower. Set the starting balance with `make airlabs-quota` (make eks-deploy asks for it); every live lookup is deducted from it.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "textMode": "value",
        "colorMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "min(airlabs_quota_remaining)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "green",
                "value": 150
              }
            ]
          },
          "unit": "suffix: / 1000"
        }
      }
    },
    {
      "type": "row",
      "title": "LLM calls",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "LLM calls by outcome",
      "description": "Calls to the LLM per minute, by result: ok, truncated (hit the token cap), empty, malformed, request_error, transient_error.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(llm_calls_total[5m]))*60",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "LLM retries by reason",
      "description": "Calls the client retried per minute, by reason: rate_limited, server_error, timeout, connection.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(llm_retries_total[5m]))*60",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tokens per minute",
      "description": "Tokens the LLM provider reported per minute: prompt (what we send) and completion (what it writes).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(rag_tokens_total[5m]))*60",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "row",
      "title": "Pods",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU used per pod",
      "description": "CPU cores each pod uses. The API pods peak while answering a question.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"fdr|monitoring\",container!=\"\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory used, % of limit",
      "description": "Each container's memory as a share of its limit. At 100% the container is killed (OOMKilled) and restarted.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum by (pod, container) (container_memory_working_set_bytes{namespace=~\"fdr|monitoring\",container!=\"\"}) / sum by (pod, container) (kube_pod_container_resource_limits{namespace=~\"fdr|monitoring\",resource=\"memory\"})",
          "legendFormat": "{{pod}} / {{container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Restarts per pod",
      "description": "Container restarts per pod in 15-minute windows. Repeated restarts = a crash loop: check kubectl describe pod.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"fdr|monitoring\"}[15m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
